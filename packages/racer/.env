# Racer deployment — read by Kamal via config/deploy-racer.yml.
# Source it before deploying: set -a && . packages/racer/.env && set +a
# The registry password is not here: it comes from KAMAL_REGISTRY_PASSWORD.

# Container image on Docker Hub
DOCKER_RACER_IMAGE_NAME=ruhmesmeile/tsnm-racer

# Registry account
DOCKER_USERNAME=ruhmesmeile

# Hosting server (same host as the website)
HOSTING_SERVER_IP=2.29.21.50

# Public domain (SSL auto-provisioned via Let's Encrypt)
RACER_PUBLIC_DOMAIN=racer.tsnm.de
